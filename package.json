{
    "name": "chatgpt-telegram-workers",
    "type": "module",
    "version": "2.3.1",
    "description": "Telegram bot for local and Docker deployment with OpenAI and OpenAI-compatible APIs.",
    "author": "tbxark <tbxark@outlook.com>",
    "license": "MIT",
    "packageManager": "npm@10.8.2",
    "repository": "git@github.com:TBXark/ChatGPT-Telegram-Workers.git",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "overrides": {
        "eslint-flat-config-utils": "3.0.2"
    },
    "scripts": {
        "lint": "eslint --fix *.js *.ts src scripts",
        "build": "vite build",
        "build:local": "npm run build",
        "build:docker": "npm run build && cd dist && docker build -t chatgpt-telegram-workers:latest .",
        "build:dockerx": "npm run build && cd dist && docker build --platform linux/amd64,linux/arm64 -t tbxark/chatgpt-telegram-workers:latest --push .",
        "start:dist": "node dist/index.js",
        "start:local": "tsx src/adapter/local/index.ts",
        "test": "vitest",
        "verify": "npm run lint && npm test -- --run && npm run build",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@ai-sdk/mcp": "^1.0.41",
        "@ai-sdk/openai": "^3.0.63",
        "@ai-sdk/openai-compatible": "^2.0.47",
        "@ai-sdk/provider": "^3.0.10",
        "@ffmpeg.wasm/core-st": "^0.13.2",
        "@ffmpeg.wasm/main": "^0.13.1",
        "ai": "^6.0.177",
        "node-cron": "^4.2.1",
        "redis": "^5.12.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@antfu/eslint-config": "8.2.0",
        "@types/node": "^25.6.2",
        "@types/node-cron": "^3.0.11",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.3.0",
        "eslint-plugin-format": "2.0.1",
        "rollup-plugin-node-externals": "^8.1.2",
        "telegram-bot-api-types": "^9.6.0",
        "toml": "^4.1.1",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.11",
        "vite-plugin-checker": "^0.13.0",
        "vitest": "^4.1.5"
    }
}
